# Environments
.env
venv/
env/
.venv/
.venv_checkov/
__pycache__/
*.pyc
*.egg-info/
src/*.egg-info/

# Terraform's shared provider plugin cache (see validate_iac.py) -- keeps
# `terraform init` from re-downloading providers into every scenario dir.
.terraform_plugin_cache/

# ALL data lives on Hugging Face -- nothing under data/ is tracked here.
#   https://huggingface.co/datasets/AnimeshShaw/GenIaC-SecBench
# This includes the scenario prompts and the anonymized reviewer CSVs: they are
# inputs to the benchmark, not source code, and splitting them across two hosts
# meant a clone could silently disagree with the published dataset. `python
# scripts/download_dataset.py` restores the whole tree.
#
# REVIEWER_KEY_local_only.csv (the mapping from R1-R3 to real identities) is
# covered by this blanket ignore and is additionally blocked by an explicit
# assertion in scripts/upload_dataset.py. It must never leave this machine.
data/
!data/.keep

# Local per-scenario Terraform caches (created transiently by `terraform
# init` during Phase 2 validation; cleaned up automatically, but ignore
# defensively in case a run is interrupted mid-scenario).
data/generated/**/.terraform/
data/generated/**/.terraform.lock.hcl

# Third-party scanner/validator binaries and cloned tool repos -- large,
# platform-specific, and independently re-fetchable via third_party/install.*
third_party/kics/
third_party/arm-ttk/
third_party/*.exe
third_party/*.tar.gz
third_party/*.zip

# IDEs
.vscode/
.idea/

# Pre-remediation snapshot / historical result archive (kept locally for
# provenance, not versioned -- see data/_archive_v1/PROVENANCE.md)
data/_archive_v1/

# Legacy scratch scripts retained for reference; not part of the pipeline
archive/legacy_scratch/*.b64

# LaTeX build artifacts (main.pdf IS tracked -- it is the deliverable)
paper/*.aux
paper/*.log
paper/*.out
paper/*.blg
paper/*.bbl
paper/*.toc
paper/*.synctex.gz

# arXiv submission package (source is generated; tarball is the deliverable)
paper/arxiv/*.aux
paper/arxiv/*.log
paper/arxiv/*.out

# The paper and its build artifacts are not distributed via this repository.
# The compiled PDF and arXiv package are published through arXiv instead; keeping
# LaTeX sources here invites divergence between the repo copy and the submitted
# version, and the 7 MB of figures/PDF dominates an otherwise small code repo.
paper/

# Superseded scratch scripts kept locally for provenance only. Their defects are
# documented in docs/THREATS_TO_VALIDITY.md; shipping them invites someone
# running a script that is known to be wrong.
archive/
