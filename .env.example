# GenIaC-SecBench - API Keys
# Copy this file to .env and fill in your keys

# OpenAI (for GPT-5, GPT-5-thinking, GPT-4o)
OPENAI_API_KEY=sk-...

# Anthropic (for Claude Opus 4.6, Claude Opus 4.6-thinking, Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=sk-ant-...

# Google (for Gemini 3.1 Pro, Gemini 3.7 Flash)
GEMINI_API_KEY=...

# xAI (Phase 5: Grok 4.6 as the independent LLM judge -- src/geniac_secbench/phase5_llm_judge/judge.py)
XAI_API_KEY=xai-...

# Local SLMs (llama3, mistral, phi3) run via Ollama and need no API key --
# see src/geniac_secbench/phase1_generation/slm_orchestrator.py.
